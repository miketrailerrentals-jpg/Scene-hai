rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny: strictly forbid access to any document unless explicitly permitted
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasOnly(['displayName', 'bio', 'city', 'area', 'interests', 'createdAt', 'updatedAt'])
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 50
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 160))
        && (!('city' in data) || (data.city is string && data.city.size() <= 50))
        && (!('area' in data) || (data.area is string && data.area.size() <= 60))
        && (!('interests' in data) || (data.interests is list && data.interests.size() <= 20))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidScene(data) {
      return data.keys().hasOnly([
        'hostId', 'hostDisplayName', 'title', 'description', 'category',
        'city', 'area', 'venue', 'startsAt', 'timezone', 'budgetPerPerson',
        'maxParticipants', 'approvedCount', 'lastApprovedRequesterId', 'lastRemovedRequesterId',
        'privacy', 'status', 'createdAt', 'updatedAt'
      ])
        && data.hostId is string
        && data.hostDisplayName is string && data.hostDisplayName.size() > 0 && data.hostDisplayName.size() <= 50
        && data.title is string && data.title.size() >= 5 && data.title.size() <= 70
        && data.description is string && data.description.size() >= 15 && data.description.size() <= 500
        && data.category in ['sports', 'food', 'gaming', 'outdoors', 'tech', 'creative', 'music']
        && data.city is string && data.city.size() > 0 && data.city.size() <= 50
        && data.area is string && data.area.size() > 0 && data.area.size() <= 60
        && (!('venue' in data) || (data.venue is string && data.venue.size() <= 100))
        && data.startsAt is timestamp
        && data.timezone == 'Asia/Karachi'
        && (data.budgetPerPerson is number || data.budgetPerPerson is int) && data.budgetPerPerson >= 0 && data.budgetPerPerson <= 500000
        && data.maxParticipants is int && data.maxParticipants >= 2 && data.maxParticipants <= 100
        && (!('approvedCount' in data) || (data.approvedCount is int && data.approvedCount >= 0 && data.approvedCount <= data.maxParticipants - 1))
        && data.maxParticipants >= (data.get('approvedCount', 0) + 1)
        && (!('lastApprovedRequesterId' in data) || (data.lastApprovedRequesterId is string && data.lastApprovedRequesterId.size() <= 128))
        && (!('lastRemovedRequesterId' in data) || (data.lastRemovedRequesterId is string && data.lastRemovedRequesterId.size() <= 128))
        && data.privacy in ['public', 'private']
        && data.status in ['active', 'cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidJoinRequest(data) {
      return data.keys().hasOnly(['requesterId', 'requesterDisplayName', 'status', 'createdAt', 'updatedAt', 'decidedAt', 'decidedBy'])
        && data.requesterId is string
        && data.requesterDisplayName is string && data.requesterDisplayName.size() > 0 && data.requesterDisplayName.size() <= 50
        && data.status in ['pending', 'withdrawn', 'approved', 'declined', 'left', 'removed']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('decidedAt' in data) || data.decidedAt is timestamp)
        && (!('decidedBy' in data) || (data.decidedBy is string && data.decidedBy.size() > 0 && data.decidedBy.size() <= 128));
    }

    // Collection group read rule for joinRequests:
    // Enables authenticated requesters to securely query their own requests across scenes
    match /{path=**}/joinRequests/{requesterUid} {
      allow read: if isAuthenticated() && (
        resource.data.requesterId == request.auth.uid
        || request.auth.uid == requesterUid
      );
    }

    // User profile documents: users/{userId}
    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && isValidUser(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(userId)
        && isValidUser(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'bio', 'city', 'area', 'interests', 'updatedAt']);

      allow delete: if false;
    }

    // Collection group read for joinRequests: allows users to query their own requests across scenes
    match /{path=**}/joinRequests/{requesterUid} {
      allow read: if isAuthenticated() && request.auth.uid == requesterUid;
    }

    // Scene documents: scenes/{sceneId}
    match /scenes/{sceneId} {
      // Read access:
      // 1. Public active scenes readable by anyone
      // 2. Hosts can read their own scenes (even private/cancelled)
      // 3. Approved attendees (including left/removed history) can read the scene even if cancelled
      allow read: if (resource.data.privacy == 'public' && resource.data.status == 'active')
        || (isAuthenticated() && (
          resource.data.hostId == request.auth.uid
          || (
            exists(/databases/$(database)/documents/scenes/$(sceneId)/joinRequests/$(request.auth.uid))
            && get(/databases/$(database)/documents/scenes/$(sceneId)/joinRequests/$(request.auth.uid)).data.status in ['approved', 'left', 'removed']
          )
        ));

      // Create: Authenticated users with valid profiles can create active scenes.
      allow create: if isAuthenticated()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.startsAt > request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.get('approvedCount', 0) == 0
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.hostDisplayName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
        && isValidScene(request.resource.data);

      // Scene update permissions: Host edits/approvals/removals OR Participant leaving
      allow update: if isAuthenticated() && (
        // Branch 1: Host updates their scene
        (
          resource.data.hostId == request.auth.uid
          && request.resource.data.hostId == resource.data.hostId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.hostDisplayName == resource.data.hostDisplayName
          && request.resource.data.updatedAt == request.time
          && isValidScene(request.resource.data)
          && (
            // 1A: General metadata edit or cancellation (cannot change approvedCount)
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'title', 'description', 'category', 'city', 'area', 'venue',
                'startsAt', 'budgetPerPerson', 'maxParticipants', 'privacy', 'status', 'approvedCount', 'updatedAt'
              ])
              && request.resource.data.get('approvedCount', 0) == resource.data.get('approvedCount', 0)
              && request.resource.data.maxParticipants >= request.resource.data.get('approvedCount', 0) + 1
            )
            // 1B: Host approval atomic increment (+1) strictly bound to a pending join request transitioning to approved
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvedCount', 'lastApprovedRequesterId', 'updatedAt'])
              && request.resource.data.approvedCount == resource.data.get('approvedCount', 0) + 1
              && request.resource.data.approvedCount <= request.resource.data.maxParticipants - 1
              && resource.data.status == 'active'
              && resource.data.startsAt > request.time
              && request.resource.data.lastApprovedRequesterId is string
              && exists(/databases/$(database)/documents/scenes/$(sceneId)/joinRequests/$(request.resource.data.lastApprovedRequesterId))
              && get(/databases/$(database)/documents/scenes/$(sceneId)/joinRequests/$(request.resource.data.lastApprovedRequesterId)).data.status == 'pending'
              && getAfter(/databases/$(database)/documents/scenes/$(sceneId)/joinRequests/$(request.resource.data.lastApprovedRequesterId)).data.status == 'approved'
              && getAfter(/databases/$(database)/documents/scenes/$(sceneId)/joinRequests/$(request.resource.data.lastApprovedRequesterId)).data.decidedBy == request.auth.uid
            )
            // 1C: Host removal of approved participant atomic decrement (-1) strictly bound to an approved request transitioning to removed
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvedCount', 'lastRemovedRequesterId', 'updatedAt'])
              && request.resource.data.approvedCount == resource.data.get('approvedCount', 0) - 1
              && request.resource.data.approvedCount >= 0
              && request.resource.data.lastRemovedRequesterId is string
              && exists(/databases/$(database)/documents/scenes/$(sceneId)/joinRequests/$(request.resource.data.lastRemovedRequesterId))
              && get(/databases/$(database)/documents/scenes/$(sceneId)/joinRequests/$(request.resource.data.lastRemovedRequesterId)).data.status == 'approved'
              && getAfter(/databases/$(database)/documents/scenes/$(sceneId)/joinRequests/$(request.resource.data.lastRemovedRequesterId)).data.status == 'removed'
              && getAfter(/databases/$(database)/documents/scenes/$(sceneId)/joinRequests/$(request.resource.data.lastRemovedRequesterId)).data.decidedBy == request.auth.uid
            )
          )
        )
        // Branch 2: Approved Participant leaves scene, decrementing approvedCount by 1
        || (
          resource.data.hostId != request.auth.uid
          && exists(/databases/$(database)/documents/scenes/$(sceneId)/joinRequests/$(request.auth.uid))
          && get(/databases/$(database)/documents/scenes/$(sceneId)/joinRequests/$(request.auth.uid)).data.status == 'approved'
          && getAfter(/databases/$(database)/documents/scenes/$(sceneId)/joinRequests/$(request.auth.uid)).data.status == 'left'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvedCount', 'updatedAt'])
          && request.resource.data.approvedCount == resource.data.get('approvedCount', 0) - 1
          && request.resource.data.approvedCount >= 0
          && request.resource.data.hostId == resource.data.hostId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.hostDisplayName == resource.data.hostDisplayName
          && request.resource.data.maxParticipants == resource.data.maxParticipants
          && request.resource.data.title == resource.data.title
          && isValidScene(request.resource.data)
          && request.resource.data.updatedAt == request.time
        )
      );

      // Deletion is strictly forbidden
      allow delete: if false;

      // Real join requests: scenes/{sceneId}/joinRequests/{requesterUid}
      match /joinRequests/{requesterUid} {
        // Read: requester can read their own request; host of the parent scene can read all requests
        allow read: if isAuthenticated() && (
          request.auth.uid == requesterUid ||
          get(/databases/$(database)/documents/scenes/$(sceneId)).data.hostId == request.auth.uid
        );

        // Create: authenticated users can request to join upcoming, active, public scenes
        allow create: if isAuthenticated()
          && request.auth.uid == requesterUid
          && request.resource.data.requesterId == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && !('decidedAt' in request.resource.data)
          && !('decidedBy' in request.resource.data)
          && isValidJoinRequest(request.resource.data)
          && exists(/databases/$(database)/documents/scenes/$(sceneId))
          && get(/databases/$(database)/documents/scenes/$(sceneId)).data.hostId != request.auth.uid
          && get(/databases/$(database)/documents/scenes/$(sceneId)).data.privacy == 'public'
          && get(/databases/$(database)/documents/scenes/$(sceneId)).data.status == 'active'
          && get(/databases/$(database)/documents/scenes/$(sceneId)).data.startsAt > request.time
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && request.resource.data.requesterDisplayName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName;

        // Update: governed by strict state transitions
        allow update: if isAuthenticated()
          && isValidJoinRequest(request.resource.data)
          && request.resource.data.requesterId == resource.data.requesterId
          && request.resource.data.requesterDisplayName == resource.data.requesterDisplayName
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          // Terminal state safeguard: once in a terminal state (declined, left, removed), no further updates allowed
          && !(resource.data.status in ['declined', 'left', 'removed'])
          && (
            // 1: Participant withdraws pending request (pending -> withdrawn)
            (
              request.auth.uid == requesterUid
              && resource.data.status == 'pending'
              && request.resource.data.status == 'withdrawn'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            )
            // 2: Participant re-submits withdrawn request (withdrawn -> pending)
            || (
              request.auth.uid == requesterUid
              && resource.data.status == 'withdrawn'
              && request.resource.data.status == 'pending'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
              && get(/databases/$(database)/documents/scenes/$(sceneId)).data.status == 'active'
              && get(/databases/$(database)/documents/scenes/$(sceneId)).data.startsAt > request.time
            )
            // 3: Participant leaves approved scene (approved -> left) with atomic capacity release
            || (
              request.auth.uid == requesterUid
              && resource.data.status == 'approved'
              && request.resource.data.status == 'left'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
              && getAfter(/databases/$(database)/documents/scenes/$(sceneId)).data.approvedCount == get(/databases/$(database)/documents/scenes/$(sceneId)).data.get('approvedCount', 0) - 1
            )
            // 4: Host approves pending request (pending -> approved) with atomic capacity increment
            || (
              request.auth.uid == get(/databases/$(database)/documents/scenes/$(sceneId)).data.hostId
              && resource.data.status == 'pending'
              && request.resource.data.status == 'approved'
              && request.resource.data.decidedBy == request.auth.uid
              && request.resource.data.decidedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy', 'updatedAt'])
              && get(/databases/$(database)/documents/scenes/$(sceneId)).data.status == 'active'
              && get(/databases/$(database)/documents/scenes/$(sceneId)).data.startsAt > request.time
              && getAfter(/databases/$(database)/documents/scenes/$(sceneId)).data.approvedCount == get(/databases/$(database)/documents/scenes/$(sceneId)).data.get('approvedCount', 0) + 1
              && getAfter(/databases/$(database)/documents/scenes/$(sceneId)).data.approvedCount <= get(/databases/$(database)/documents/scenes/$(sceneId)).data.maxParticipants - 1
              && getAfter(/databases/$(database)/documents/scenes/$(sceneId)).data.lastApprovedRequesterId == requesterUid
            )
            // 5: Host declines pending request (pending -> declined)
            || (
              request.auth.uid == get(/databases/$(database)/documents/scenes/$(sceneId)).data.hostId
              && resource.data.status == 'pending'
              && request.resource.data.status == 'declined'
              && request.resource.data.decidedBy == request.auth.uid
              && request.resource.data.decidedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy', 'updatedAt'])
            )
            // 6: Host removes approved participant (approved -> removed) with atomic capacity release
            || (
              request.auth.uid == get(/databases/$(database)/documents/scenes/$(sceneId)).data.hostId
              && resource.data.status == 'approved'
              && request.resource.data.status == 'removed'
              && request.resource.data.decidedBy == request.auth.uid
              && request.resource.data.decidedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy', 'updatedAt'])
              && getAfter(/databases/$(database)/documents/scenes/$(sceneId)).data.approvedCount == get(/databases/$(database)/documents/scenes/$(sceneId)).data.get('approvedCount', 0) - 1
              && getAfter(/databases/$(database)/documents/scenes/$(sceneId)).data.lastRemovedRequesterId == requesterUid
            )
          );

        // Delete: strictly forbidden
        allow delete: if false;
      }

      // Confidential Venue Details: scenes/{sceneId}/privateDetails/{detailDoc}
      // Accessible ONLY by the scene host or approved participants
      match /privateDetails/{detailDoc} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/scenes/$(sceneId)).data.hostId == request.auth.uid
          || (
            exists(/databases/$(database)/documents/scenes/$(sceneId)/joinRequests/$(request.auth.uid))
            && get(/databases/$(database)/documents/scenes/$(sceneId)/joinRequests/$(request.auth.uid)).data.status == 'approved'
          )
        );

        allow create, update: if isAuthenticated()
          && get(/databases/$(database)/documents/scenes/$(sceneId)).data.hostId == request.auth.uid
          && request.resource.data.keys().hasOnly(['venue', 'hostNotes', 'updatedAt'])
          && request.resource.data.venue is string && request.resource.data.venue.size() <= 200
          && (!('hostNotes' in request.resource.data) || (request.resource.data.hostNotes is string && request.resource.data.hostNotes.size() <= 500))
          && request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }

      // Real-Time Group Chat Messages: scenes/{sceneId}/messages/{messageId}
      // Authorized exclusively for scene host or currently approved participants
      match /messages/{messageId} {
        // Read: Authenticated host or currently approved participant
        // For cancelled scenes, existing authorized members can still view message history
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/scenes/$(sceneId)).data.hostId == request.auth.uid
          || (
            exists(/databases/$(database)/documents/scenes/$(sceneId)/joinRequests/$(request.auth.uid))
            && get(/databases/$(database)/documents/scenes/$(sceneId)/joinRequests/$(request.auth.uid)).data.status == 'approved'
          )
        );

        // Create: Authenticated host or currently approved participant
        // Parent scene must be active (cancelled scenes reject new messages)
        allow create: if isAuthenticated()
          && (
            get(/databases/$(database)/documents/scenes/$(sceneId)).data.hostId == request.auth.uid
            || (
              exists(/databases/$(database)/documents/scenes/$(sceneId)/joinRequests/$(request.auth.uid))
              && get(/databases/$(database)/documents/scenes/$(sceneId)/joinRequests/$(request.auth.uid)).data.status == 'approved'
            )
          )
          && get(/databases/$(database)/documents/scenes/$(sceneId)).data.status == 'active'
          && request.resource.data.keys().hasOnly(['senderId', 'senderDisplayName', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && request.resource.data.senderDisplayName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000
          && request.resource.data.text.matches('.*\\S.*')
          && request.resource.data.createdAt == request.time;

        // Message updates and deletions are strictly forbidden
        allow update, delete: if false;
      }
    }
  }
}
